{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && bash scripts/vercel-install.sh",
  "buildCommand": "cd ../.. && pnpm build:wasm && pnpm --filter @tooscut/render-engine build && cd apps/ui && pnpm build",
  "rewrites": [
    { "source": "/docs", "destination": "https://tooscut-docs.vercel.app/docs" },
    { "source": "/docs/:path*", "destination": "https://tooscut-docs.vercel.app/docs/:path*" },
    { "source": "/blog", "destination": "https://tooscut-docs.vercel.app/blog" },
    { "source": "/blog/:path*", "destination": "https://tooscut-docs.vercel.app/blog/:path*" },
    { "source": "/api/search", "destination": "https://tooscut-docs.vercel.app/api/search" }
  ]
}
